HOMEPAGE="https://github.com/corporateshark/${PN}"
SRC_URI="https://github.com/corporateshark/${PN}/archive/refs/tags/release-${PV}.tar.gz"
SRC_DIR="${PN}-release-${PV}"

CATEGORY="Libs"
SUMMARY="Lightweight URL & URI parser (RFC 1738, RFC 3986)"
DESCRIPTION="${SUMMARY}"

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="License.txt"

inherit cmake

CYGCMAKE_ARGS="
	-DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5
	-DSOVERSION:STRING=${PV[1]}
	-DVERSION:STRING=${PV}
"

DOCS="
	License.txt
"

PKG_NAMES="
	LUrlParser
	libLUrlParser1
	libLUrlParser-devel
"
LUrlParser_CONTENTS="
	usr/bin/*.exe
	usr/share
"
libLUrlParser1_CONTENTS="
	usr/bin/cyg*-${PV[1]}.dll
"
libLUrlParser_devel_CONTENTS="
	usr/include
	usr/lib
"
LUrlParser_SUMMARY="${SUMMARY} (utilities)"
libLUrlParser1_SUMMARY="${SUMMARY} (runtime)"
libLUrlParser_devel_SUMMARY="${SUMMARY} (development)"
