HOMEPAGE="https://github.com/rafael2k/${PN}"
SRC_URI="https://github.com/rafael2k/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Audio"
SUMMARY="Live audio streamer"
DESCRIPTION="DarkIce is a live audio streamer. It records audio from an audio interface
(e.g. sound card), encodes it and sends it to a streaming server."

LICENSE="GPL-3.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-3.0-or-later"
LICENSE_URI="${PN}/trunk/COPYING"

BUILD_REQUIRES="
    flac-devel
    libfaac-devel
    libfdk-aac-devel
    libmp3lame-devel
    libogg-devel
    libopus-devel
    libpulse-devel
    libsamplerate-devel
    libtwolame-devel
    libvorbis-devel
"

src_compile() {
    CYGCONF_SOURCE=${S}/${PN}/trunk
    cd ${CYGCONF_SOURCE}
    cygautoreconf
    cd ${B}
    cygconf
    cygmake
}

src_test()
{
    cd ${B}
    verbose ./src/${PN}.exe -h
}

DOCS="
    ${PN}/trunk/AUTHORS
    ${PN}/trunk/ChangeLog
    ${PN}/trunk/COPYING
    ${PN}/trunk/FAQ
    ${PN}/trunk/NEWS
    ${PN}/trunk/README
    ${PN}/trunk/TODO
"
