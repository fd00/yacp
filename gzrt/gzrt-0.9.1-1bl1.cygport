HOMEPAGE="https://github.com/arenn/${PN}"
SRC_URI="https://github.com/arenn/${PN}/archive/refs/tags/v${PV}.tar.gz"
PATCH_URI="
	https://sources.debian.org/data/main/${PN:0:1}/${PN}/${PV}-1/debian/patches/fix-makefile.patch
"

CATEGORY="Archive"
SUMMARY="Gzip recovery toolkit"
DESCRIPTION="Recover data from a corrupted gzip file"

LICENSE="GPL-2.0-or-later"
LICENSE_SPDX="SPDX-License-Identifier: GPL-2.0-or-later"
# LICENSE_URI=""

BUILD_REQUIRES="
	zlib-devel
"

src_compile()
{
	cd ${B}
	lndirs
	cygmake
}

src_test()
{
	cd ${B}
	verbose ./gzrecover.exe -V < /dev/null
}

src_install()
{
	cd ${B}
	dobin gzrecover.exe
	doman gzrecover.1
}
