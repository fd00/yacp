HOMEPAGE="https://github.com/rtissera/${PN}"
SRC_URI="https://github.com/rtissera/${PN}/archive/refs/tags/v${PV}.tar.gz"
PATCH_URI="
	https://gitweb.gentoo.org/repo/gentoo.git/plain/media-libs/${PN}/files/${P}-zstd-cmake.patch
"

CATEGORY="Libs"
SUMMARY="Standalone library for reading MAME's CHDv1-v5 formats"
DESCRIPTION="${SUMMARY}"

LICENSE="BSD-3-Clause"
LICENSE_SPDX="SPDX-License-Identifier: BSD-3-Clause"
LICENSE_URI="LICENSE.txt"

BUILD_REQUIRES="
	libzstd-devel
	zlib-devel
"

inherit cmake

CYGCMAKE_ARGS="
	-DWITH_SYSTEM_ZLIB:BOOL=ON
	-DWITH_SYSTEM_ZSTD:BOOL=ON
"

DOCS="
	CHANGELOG.md
"

PKG_NAMES="
	libchdr
	libchdr0
	libchdr-devel
"
libchdr_CONTENTS="
	usr/share
"
libchdr0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libchdr_devel_CONTENTS="
	usr/include
	usr/lib
"
libchdr_SUMMARY="${SUMMARY} (licensing & readmes)"
libchdr0_SUMMARY="${SUMMARY} (runtime)"
libchdr_devel_SUMMARY="${SUMMARY} (development)"
