HOMEPAGE="https://github.com/pantoniou/${PN}"
SRC_URI="https://github.com/pantoniou/${PN}/archive/refs/tags/v${PV}.tar.gz"

CATEGORY="Libs"
SUMMARY="Fully feature complete YAML parser"
DESCRIPTION="A fancy 1.2 YAML and JSON parser/writer."

LICENSE="MIT"
LICENSE_SPDX="SPDX-License-Identifier: MIT"
LICENSE_URI="LICENSE"

BUILD_REQUIRES="
	check
	libxxhash-devel
	libyaml-devel
"

export CPPFLAGS="${CPPFLAGS} -DXXH_STATIC_LINKING_ONLY"

inherit cmake

# Sphinx (4.4.0 here) fails building the man/latex targets on this system
# ("No module named 'roman'"), which is fatal at install time since the
# upstream CMakeLists.txt regenerates man pages via install(CODE ...).
# Force find_program() to treat sphinx-build as not found so doc targets
# and the install-time man page (re)generation are skipped entirely; the
# canned man page shipped in doc/canned-man/fy-tool.1 is installed instead.
CYGCMAKE_ARGS="
	-DSPHINX_EXECUTABLE=SPHINX_EXECUTABLE-NOTFOUND
"

PKG_NAMES="
	libfyaml
	libfyaml0
	libfyaml-devel
"
libfyaml_CONTENTS="
	usr/bin/fy-*
	usr/share
"
libfyaml0_CONTENTS="
	usr/bin/cyg*-0.dll
"
libfyaml_devel_CONTENTS="
	usr/include
	usr/lib
"
libfyaml_SUMMARY="${SUMMARY} (utilities)"
libfyaml0_SUMMARY="${SUMMARY} (runtime)"
libfyaml_devel_SUMMARY="${SUMMARY} (development)"
