 )
 
+if(HAVE_XXHASH)
+    target_link_directories(fyaml PRIVATE ${XXHASH_LIBRARY_DIRS})
+endif()
+
 if(NOT WIN32)
     target_link_libraries(fyaml
         PUBLIC
             Threads::Threads
+            $<$<BOOL:${HAVE_XXHASH}>:${XXHASH_LIBRARIES}>
